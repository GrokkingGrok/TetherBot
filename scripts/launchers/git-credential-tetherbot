#!/usr/bin/env bash
# git credential helper launcher. Git writes attributes on stdin and reads
# the answer on stdout. This wrapper does not print, log, or store them.
set -euo pipefail

data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
app="${data_home}/tetherbot/app"

if [[ ! -d "${app}/tetherbot" ]]; then
  echo "git-credential-tetherbot: app is not installed under ${app}" >&2
  exit 1
fi

export PYTHONPATH="${app}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m tetherbot.credential "$@"
