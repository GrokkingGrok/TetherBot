[Unit]
Description=TetherBot bridge
After=graphical-session.target

[Service]
Type=simple
# The process is `python -m tetherbot`. ExecStart stays /bin/false until
# scripts/install.sh installs %h/.local/bin/tetherbot. D-Bus activation
# stays /bin/false until the service is exported.
ExecStart=/bin/false
Restart=no
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=default.target
